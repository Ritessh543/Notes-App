<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="/output.css" />
</head>

<body class="bg-zinc-900 text-white">

    
        <div class="main w-full min-h-screen bg-zinc-900 p-10 text-white">
            <a class="text-blue-500 inline-block mb-10" href="/">Go Back to Home</a>
              <form action="/edit" method="post" class="space-y-3">
        <input class="block w-full rounded-md bg-zinc-600 px-4 py-2 outline-none focus:ring-2 focus:ring-blue-500"
          type="text" name="previous" placeholder="prev name" value="<%= filename %>" value="<%= filename %>" readonly >
        <textarea
          class="block w-full rounded-md bg-zinc-800 px-4 py-2 outline-none focus:ring-2 focus:ring-blue-500 h-32 resize-none" name="New"
          placeholder="New name"></textarea>
        <input class="bg-yellow-600 hover:bg-blue-700 px-5 py-2 rounded-md cursor-pointer font-semibold transition-colors"
          type="submit"  value="update Task" />
        </div>
    

</body>

